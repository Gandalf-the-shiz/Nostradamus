# Nostradamus API Keys
# =====================
# These keys are used by the browser app (stored in localStorage via Settings panel)
# and by GitHub Actions workflows (stored as repository secrets).
#
# ALL KEYS ARE OPTIONAL. The app works in demo mode without any keys.
# When keys are configured, they're used in this fallback order:
#   1. Finnhub (primary)    — Free: 60 API calls/min
#   2. Twelve Data          — Free: 800 calls/day, 8 calls/min
#   3. Polygon.io           — Free: unlimited (prev-day data only)
#
# Get free API keys at:
#   Finnhub:     https://finnhub.io/register
#   Twelve Data: https://twelvedata.com/pricing
#   Polygon.io:  https://polygon.io/pricing

# Required for real-time quotes and WebSocket streaming
FINNHUB_API_KEY=

# Optional — secondary fallback for quotes and time series
TWELVEDATA_API_KEY=

# Optional — tertiary fallback, good for previous-close data
POLYGON_API_KEY=

# Note: The nightly historical data pipeline (fetch-history.py) uses
# yfinance which does NOT require an API key. Data is fetched from
# Yahoo Finance for free with no rate limits.
